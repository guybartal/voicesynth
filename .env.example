# Sign in with az login. No API key is needed or used.
# Copy the full resource ID from Azure portal > resource > Properties.
AZURE_SPEECH_RESOURCE_ID=
AZURE_SPEECH_REGION=

# Required only for Personal Voice. Use this same resource's custom subdomain.
# Enabling a new custom subdomain on Azure is irreversible.
AZURE_SPEECH_ENDPOINT=

# Optional local HTTP port (default: 3000).
PORT=3000

# Optional MCP audio output directory; relative paths resolve from the app folder.
# Files persist until you delete them. The browser app does not use this setting.
VOICESYNTH_OUTPUT_DIR=outputs
